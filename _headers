# Cloudflare Pages headers
# HTML always revalidates. Static assets get a short browser cache so repeat
# visits do not redownload dozens of modules; five minutes limits stale deploys.
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
